{% extends '@SecurityMerchantPortalGui/Layout/layout.twig' %}

{% set title = 'Two-Factor Authentication' | trans %}

{% block form %}
    {% form_theme form '@ZedUi/Form/form-webcomponent-layout.twig' %}

    {{ form_errors(form) }}
    {{ form_start(form, {action: '/multi-factor-auth-merchant-portal/merchant-user-oauth-multi-factor-auth-flow/get-enabled-types', attr: {novalidate: ''}}) }}
        {{ form_widget(form) }}
        <web-spy-button type="submit" class="{{ submitButtonClass }}" cloak>{{ 'Continue' | trans }}</web-spy-button>
    {{ form_end(form) }}
{% endblock %}
